# Copy to .env.local and adjust. Every variable is optional for local development.

# Database — local SQLite file by default; use a libsql/Turso URL in production.
DATABASE_URL=file:./data/hrms.db
# DATABASE_AUTH_TOKEN=

# Public URL used in notification links, relay emails and invitations.
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata

# Private uploads (verification documents, resumes, photos). Never inside /public.
# STORAGE_DIR=./storage/uploads

# Privacy relay: masked addresses look like hr_53543@<RELAY_DOMAIN>.
RELAY_DOMAIN=panel.com
# Shared secret your mail provider sends as the x-relay-secret header to /api/mail/inbound.
# RELAY_WEBHOOK_SECRET=

# Bearer token for POST /api/cron (interview reminders, 60-day milestones, invoices, matching).
# CRON_SECRET=

# Email delivery (otherwise emails are logged under Admin → Notification log).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="HRMS Talent <no-reply@panel.com>"

# SMS / WhatsApp via Twilio (otherwise logged).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15550000000
# TWILIO_WHATSAPP_FROM=+15550000001

# Interview AI assistant — uses Claude when set, otherwise the built-in summariser.
# ANTHROPIC_API_KEY=
# INTERVIEW_ASSISTANT_MODEL=claude-opus-5

# Show the demo-account panel on the login page in production builds.
# SHOW_DEMO_ACCOUNTS=1
